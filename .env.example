# Kopjoje në .env.local (lokalisht) dhe vendosi të njëjtat te Vercel > Settings > Environment Variables.
# ASNJË nga këto nuk shkon në browser, përveç atyre me NEXT_PUBLIC_.

# Supabase > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://XXXX.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_XXXX
SUPABASE_SECRET_KEY=sb_secret_XXXX

# Vetëm për migrime nga Termux (psql). Supabase > Connect > Session pooler. Mos e vendos në Vercel.
DATABASE_URL=postgresql://postgres.XXXX:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# https://console.anthropic.com  (vendos edhe një spend limit mujor atje)
ANTHROPIC_API_KEY=sk-ant-XXXX
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# https://dashboard.voyageai.com
VOYAGE_API_KEY=pa-XXXX
VOYAGE_MODEL=voyage-4-lite

# openssl rand -hex 32   (dy vlera TË NDRYSHME; mos i ndrysho pas lançimit)
WIDGET_TOKEN_SECRET=
CHANNEL_ENCRYPTION_KEY=

# Domeni publik i prodhimit (jo preview URL): përdoret për webhook-un e Telegramit.
APP_URL=https://PROJEKTI.vercel.app

# Opsionale — pa këto, kodi punon dhe thjesht nuk dërgon traces.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Website -> Knowledge Base (docs/WEBSITE-KB.md) ---
# Sekreti që mbron /api/cron/crawl (Vercel Cron / pg_cron). openssl rand -hex 32
CRON_SECRET=
# Opsionale (vlerat default janë të sigurta):
# EMBEDDING_PROVIDER=voyage
# KB_CHUNK_MAX_CHARS=1200
# KB_CHUNK_OVERLAP_CHARS=150
# KB_MIN_SIMILARITY=0.25
# KB_MAX_CONTEXT_CHUNKS=6
# KB_MAX_CONTEXT_CHARS=8000
# CRAWLER_TICK_BUDGET_MS=45000
# CRAWLER_TIMEOUT_MS=15000
# CRAWLER_MAX_BYTES=2000000
# CRAWLER_MIN_DELAY_MS=500
# CRAWLER_MAX_ATTEMPTS=3
# CRAWLER_ALLOWED_PORTS=80,443
# CRAWLER_REQUIRE_VERIFICATION=true
# MOS e vendos kurrë në production: CRAWLER_DEV_HOST_MAP (vetëm për teste).
